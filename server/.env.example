# Copy to server/.env and fill in. Never commit server/.env.
# On Render, set these as environment variables instead.
GEMINI_API_KEY=
# Comma-separated fallback list: a rate-limited model hands over to the next.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Devnet RPC (Helius recommended). Falls back to the public devnet endpoint.
SOLANA_RPC_URL=
# Public URL of this server (used in invoices and vendor listings).
PUBLIC_BASE_URL=http://localhost:4000
# Folder with the demo keypairs (agent, vendors, crank, attacker, owner).
# Locally: .keys. On Render: /etc/secrets (Secret Files).
KEYS_DIR=.keys
