{
  "name": "payguard",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "server": "tsx server/index.ts",
    "agent": "tsx server/cli.ts",
    "mcp": "tsx mcp/server.ts",
    "web": "pnpm --filter web dev",
    "e2e": "tsx scripts/e2e.ts",
    "test:program": "cargo build-sbf --manifest-path programs/payguard/Cargo.toml --sbf-out-dir target/test-sbf --arch v0 --tools-version v1.57 && cargo test -p payguard --test escrow",
    "sync:idl": "cp target/idl/payguard.json sdk/src/idl/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "keys:export": "tsx scripts/keys-export.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "@payguard/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  }
}
